# Скопировать в .env и при необходимости поменять. Без .env работают dev-значения.
# .env в git НЕ коммитить.

HTTP_PORT=80
POSTGRES_PORT=5432
POSTGRES_PASSWORD=postgres_dev

# Пароли пользователей БД — по одному на сервис
AUTH_DB_PASSWORD=auth_dev        # Go — auth-service
CORE_DB_PASSWORD=core_dev        # Java — core-api
ETL_DB_PASSWORD=etl_dev          # Python — ETL
NOTIFY_DB_PASSWORD=notify_dev    # Go — notifier (продукт 2)
CALC_DB_PASSWORD=calc_dev        # C# — калькулятор (резерв)

# Общий секрет для /internal/* между сервисами
INTERNAL_TOKEN=internal_dev_token

